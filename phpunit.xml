<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests</directory>
            <exclude>tests/Feature</exclude>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_KEY" value="base64:YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE=" force="true"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="STAYS_SEARCH_CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="STAYS_SIMULATOR_ENABLED" value="false"/>
        <env name="DIRECT_BOOKING_ROLLOUT_MODE" value="pilot" force="true"/>
        <env name="DIRECT_BOOKING_CATALOG_SOURCE" value="local" force="true"/>
        <env name="DIRECT_BOOKING_STAYS_TERMS_ENABLED" value="false" force="true"/>
        <env name="DIRECT_BOOKING_PAYMENT_PROVIDER" value="mercadopago" force="true"/>
        <env name="DIRECT_BOOKING_CHECKOUT_UI_ENABLED" value="false" force="true"/>
        <env name="CIELO_DIRECT_ENVIRONMENT" value="sandbox" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
