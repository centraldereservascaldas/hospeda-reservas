{
  "name": "imobsys-connector-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serviço local e isolado de consultas ImobSys. Não reserva nem cobra.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "catalog:map": "node scripts/map-catalog.mjs",
    "worker:start": "node scripts/standalone-browser-worker.mjs",
    "media:collect": "node scripts/collect-media.mjs",
    "catalog:stage": "node scripts/stage-listings.mjs",
    "availability:map": "node scripts/map-authenticated-availability.mjs",
    "availability:rolling": "node scripts/map-rolling-availability.mjs",
    "integration:prepare": "node scripts/prepare-integration.mjs"
  }
}
