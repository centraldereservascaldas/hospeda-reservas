# Copy these names into the homologation environment only. Never commit real values.
APP_ENV=staging
APP_URL=https://staging.example.invalid
APP_KEY=base64:REPLACE_WITH_A_UNIQUE_STAGING_KEY

DB_CONNECTION=pgsql
DB_HOST=REPLACE_WITH_STAGING_DATABASE_HOST
DB_PORT=5432
DB_DATABASE=REPLACE_WITH_STAGING_DATABASE
DB_USERNAME=REPLACE_WITH_STAGING_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_STAGING_DATABASE_PASSWORD

VITE_SUPABASE_URL=https://REPLACE_WITH_STAGING_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_ANON_KEY
SUPABASE_URL=https://REPLACE_WITH_STAGING_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_STAGING_SERVICE_ROLE_KEY
OWNER_ADMIN_EMAILS=admin@example.invalid

STAYS_BASE_URL=https://REPLACE_WITH_STAYS_SANDBOX_HOST/external/v1
STAYS_CLIENT_ID=REPLACE_WITH_STAYS_SANDBOX_CLIENT_ID
STAYS_CLIENT_SECRET=REPLACE_WITH_STAYS_SANDBOX_CLIENT_SECRET
STAYS_SIMULATOR_ENABLED=false

CIELO_DIRECT_ENVIRONMENT=sandbox
CIELO_SANDBOX_ENABLED=true
CIELO_SANDBOX_MERCHANT_ID=REPLACE_WITH_CIELO_SANDBOX_MERCHANT_ID
CIELO_SANDBOX_MERCHANT_KEY=REPLACE_WITH_CIELO_SANDBOX_MERCHANT_KEY

# Keep production flags disabled in homologation.
CIELO_DIRECT_PRODUCTION_ENABLED=false
CIELO_DIRECT_PRODUCTION_SOP_ENABLED=false
CIELO_DIRECT_PRODUCTION_PIX_ENABLED=false
