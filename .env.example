STAYS_BASE_URL=https://crcn.stays.net/external/v1
STAYS_CLIENT_ID=
STAYS_CLIENT_SECRET=
# Habilitar somente na homologação durante uma reserva controlada autorizada.
STAYS_HOSTED_CHECKOUT_ENABLED=false
STAYS_HOSTED_CHECKOUT_ALLOWED_HOSTS=www.centraldereservascaldas.com.br,centraldereservascaldas.com.br
# Simulador local de anúncios, disponibilidade e cotação; bloqueado fora de local/testing
STAYS_SIMULATOR_ENABLED=false
STAYS_SIMULATOR_DATABASE=database/stays-simulator.sqlite

# Checkout CRCN (segredos apenas no servidor; valores em branco não habilitam pagamento)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# A chave pública é usada pelo SDK no navegador quando o checkout estiver integrado
VITE_MERCADO_PAGO_PUBLIC_KEY=
# Seleção para novos pedidos; pedidos existentes preservam o gateway gravado. Opções: mercadopago, cielo_sandbox, cielo, cielo_checkout.
DIRECT_BOOKING_PAYMENT_PROVIDER=mercadopago
# Preparação do checkout próprio. Independente de CIELO_ENVIRONMENT do checkout hospedado.
CIELO_DIRECT_ENVIRONMENT=sandbox
# Novas cobranças exigem também APP_ENV=production e as flags DIRECT_BOOKING, inclusive LIVE_PAYMENTS.
CIELO_DIRECT_PRODUCTION_ENABLED=false
CIELO_DIRECT_PRODUCTION_SOP_ENABLED=false
CIELO_DIRECT_PRODUCTION_MERCHANT_ID=
CIELO_DIRECT_PRODUCTION_MERCHANT_KEY=
CIELO_DIRECT_PRODUCTION_SOP_CLIENT_ID=
CIELO_DIRECT_PRODUCTION_SOP_CLIENT_SECRET=
CIELO_DIRECT_PRODUCTION_WEBHOOK_HEADER_NAME=
CIELO_DIRECT_PRODUCTION_WEBHOOK_HEADER_VALUE=
CIELO_DIRECT_PRODUCTION_WEBHOOK_QUEUE_CONNECTION=database
# Integração personalizada SOP da Cielo, somente sandbox e habilitada separadamente.
CIELO_SANDBOX_ENABLED=false
CIELO_SANDBOX_SOP_ENABLED=false
CIELO_SANDBOX_MERCHANT_ID=
CIELO_SANDBOX_MERCHANT_KEY=
CIELO_SANDBOX_SOP_CLIENT_ID=
CIELO_SANDBOX_SOP_CLIENT_SECRET=
# Opcional: header estático configurado na Cielo; ambos os valores precisam estar preenchidos juntos.
CIELO_SANDBOX_WEBHOOK_HEADER_NAME=
CIELO_SANDBOX_WEBHOOK_HEADER_VALUE=
CIELO_SANDBOX_WEBHOOK_QUEUE_CONNECTION=database
# Checkout Cielo/Link API e SOP (credenciais exclusivamente no backend)
# Client ID/Secret são os valores de Configurações > Credenciais de API no portal Cielo.
# O Checkout via iframe usa a API Link/Checkout; configure o Modo de teste no portal Cielo.
# CIELO_ENVIRONMENT controla somente endpoints do E-commerce/SOP legado do cliente CieloClient.
CIELO_ENVIRONMENT=sandbox
CIELO_MERCHANT_ID=
CIELO_MERCHANT_KEY=
CIELO_SOP_CLIENT_ID=
CIELO_SOP_CLIENT_SECRET=
PIX_KEY=
PIX_BENEFICIARY_NAME=
PIX_BENEFICIARY_CNPJ=

# Mantém a criação de pedidos/pré-reservas bloqueada até aprovação operacional explícita
DIRECT_BOOKING_ENABLED=false
# Entrada da página única: exige também imóvel piloto, termos e pagamento prontos.
DIRECT_BOOKING_CHECKOUT_UI_ENABLED=false
# Prévia visual de ingressos: permitida somente em local/testing; nunca habilita vendas.
PARK_TICKETS_PREVIEW_ENABLED=false
# O gateway só pode ser integrado em sandbox após habilitação separada
DIRECT_BOOKING_PAYMENTS_ENABLED=false
DIRECT_BOOKING_CONFIRMATION_ENABLED=false
# Em APP_ENV=production, exige aprovação separada antes de iniciar cobranças reais
DIRECT_BOOKING_LIVE_PAYMENTS_ENABLED=false
# IDs públicos CRCN dos 2 a 5 imóveis do piloto; vazio mantém o checkout sem imóveis elegíveis.
DIRECT_BOOKING_PILOT_LISTING_IDS=
# A Stays envia a confirmação ao hóspede; habilite isto apenas se quiser um e-mail adicional da Hospeda.
DIRECT_BOOKING_SEND_CONFIRMATION_EMAIL=false
DIRECT_BOOKING_STAYS_PAYMENT_TYPE=
DIRECT_BOOKING_STAYS_PAYMENT_PROVIDER_ID=
DIRECT_BOOKING_PIX_MINIMUM_REMAINING_MINUTES=30
DIRECT_BOOKING_PAYMENT_SAFETY_MARGIN_MINUTES=5
DIRECT_BOOKING_PAYMENT_RECONCILIATION_INTERVAL_SECONDS=300
# Intervalo padrão de 24 horas para rechecagem de pagamentos conciliados (mínimo de 1 hora)
DIRECT_BOOKING_SETTLED_PAYMENT_RECONCILIATION_INTERVAL_SECONDS=86400
MERCADO_PAGO_WEBHOOK_QUEUE_CONNECTION=database

# Pre-reserva interna: manter vazia até aprovar duração e operação com Stays
DIRECT_BOOKING_RESERVATION_HOLD_MINUTES=
# Validade aprovada para retomada de checkout como visitante
DIRECT_BOOKING_RESUME_TOKEN_TTL_DAYS=30

# Medição pública: configurar o contêiner antes de habilitar o carregamento no site
VITE_GTM_ID=
VITE_GA_ID=
# Sofia Concierge AI (server-only secret; never use the VITE_ prefix)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase Auth (browser; these are public project values)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase server access (secret; never prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# E-mails verificados da equipe autorizada a analisar solicitações de proprietários
OWNER_ADMIN_EMAILS=

# Laravel backend (local development)
APP_NAME="Hospeda Reservas API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
DIRECT_BOOKING_NOTIFICATION_QUEUE_CONNECTION=database

# O e-mail transacional próprio é opcional; a Stays é responsável pela confirmação da reserva.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Origens do frontend permitidas na API; no deploy, substitua pelas URLs públicas do frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
